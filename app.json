{
  "expo": {
    "name": "DogMatch Pro",
    "slug": "dogmatch-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dogmatch.pro",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DogMatch needs access to your photo library to upload your dog's photos.",
        "NSCameraUsageDescription": "DogMatch needs access to your camera to take photos of your dog.",
        "NSLocationWhenInUseUsageDescription": "DogMatch uses your location to find nearby dog matches.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "DogMatch uses your location to find nearby dog matches."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.dogmatch.pro",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-location",
      "expo-image-picker"
    ]
  }
}
